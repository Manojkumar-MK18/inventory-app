# MongoDB Atlas — app database only, least-privilege user
MONGODB_URI="mongodb+srv://appuser:PASSWORD@cluster0.xxxx.mongodb.net/pos?retryWrites=true&w=majority"

# Auth.js — generate with: openssl rand -base64 32
# NEVER change in production or all users get logged out.
AUTH_SECRET="change-me"
AUTH_URL="http://localhost:3000"

# Gmail SMTP (app password, not your real password) for password-reset mails
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER="you@gmail.com"
SMTP_PASS="gmail-app-password"
SMTP_FROM="Your Shop <you@gmail.com>"
